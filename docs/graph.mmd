---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	observe(observe)
	propose(propose)
	execute(execute)
	finalise(finalise)
	validate(validate)
	__end__([<p>__end__</p>]):::last
	__start__ --> observe;
	execute --> finalise;
	observe --> propose;
	propose --> validate;
	validate -.-> execute;
	validate -.-> propose;
	finalise --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
